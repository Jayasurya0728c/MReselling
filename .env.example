# ==============================================================================
# Nammude Picks - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and replace the placeholders with your actual Supabase credentials.
# Get these free from your Supabase Dashboard: Settings -> API
# IMPORTANT: Use ONLY the public 'anon' key in this frontend application.
# NEVER expose your 'service_role' secret key here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here
